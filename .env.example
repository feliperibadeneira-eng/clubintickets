# Copia este archivo a ".env" (local) y completa los valores reales.
# En producción (Vercel), estas mismas variables se configuran desde
# el dashboard de Vercel → tu proyecto → Settings → Environment Variables.
# Nunca subas un archivo ".env" real a git — por eso este es el único
# que sí se commitea, como plantilla.

# --- Base de datos ---
# Local: la da `npx prisma dev` (ver README/DEPLOY.md).
# Producción: la da tu proveedor de Postgres (Vercel Postgres, Neon, etc.)
# — normalmente ya viene con "?sslmode=require" incluido.
DATABASE_URL="postgres://usuario:contraseña@host:5432/basededatos"

# Solo hace falta en desarrollo local, para que Prisma pueda calcular
# migraciones nuevas. En producción no se usa.
SHADOW_DATABASE_URL="postgres://usuario:contraseña@host:5432/basededatos_shadow"

# --- Email (Gmail) ---
# Una cuenta de Gmail normal + una "contraseña de aplicación" (no la
# contraseña real de la cuenta) generada en
# myaccount.google.com/apppasswords. Hace falta tener la verificación en
# dos pasos activada en esa cuenta de Google.
GMAIL_USER="tu-cuenta@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# --- URLs ---
# La dirección pública real del sitio (sin barra al final). Se usa para
# armar los links del QR y del email. En producción es tu URL de Vercel
# (o tu dominio propio si configuraste uno).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
