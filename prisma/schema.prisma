// Modelo de datos de la ticketera.
// Diseñado multi-organización desde el día uno (ver SPEC.md sección 9),
// aunque el MVP tenga una sola organización.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// La empresa/organizador dueño de la cuenta (hoy: solo Felipe).
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  venues Venue[]
  events Event[]
  users  User[]
}

// Un lugar físico (discoteca, salón). Una organización puede tener varios.
model Venue {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  address        String?
  city           String

  organization Organization @relation(fields: [organizationId], references: [id])
  events       Event[]
}

enum UserRole {
  ORGANIZER // administra todo (hoy: solo Felipe)
  STAFF // solo puede entrar a escanear entradas en la puerta
}

// Una cuenta con usuario y contraseña: organizador o staff de puerta.
model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id])
  sessions      Session[]
  checkIns      CheckIn[]
  ticketsScanned Ticket[]    @relation("TicketUsedBy")
}

// Una sesión iniciada: la cookie del navegador solo guarda este id al azar.
model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Identidad de un comprador, identificado por su email (no tiene
// contraseña: entra por link mágico, ver BuyerLoginToken). Se crea sola la
// primera vez que esa persona paga una orden, o la primera vez que pide un
// link de ingreso para un email con compras previas.
model Buyer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loginTokens BuyerLoginToken[]
  sessions    BuyerSession[]
}

// Link mágico de un solo uso que mandamos por email para que un comprador
// entre a "Mi cuenta" sin contraseña.
model BuyerLoginToken {
  id        String    @id @default(uuid())
  buyerId   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  buyer Buyer @relation(fields: [buyerId], references: [id])

  @@index([buyerId])
}

// Sesión de un comprador ya verificado: la cookie del navegador solo
// guarda este id al azar, igual que Session para organizador/staff.
model BuyerSession {
  id        String   @id @default(uuid())
  buyerId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  buyer Buyer @relation(fields: [buyerId], references: [id])
}

enum EventStatus {
  DRAFT // el organizador lo está armando, no es visible al público
  PUBLISHED // visible y en venta
  ARCHIVED // ya pasó o se canceló
}

// Una fiesta puntual.
model Event {
  id             String      @id @default(cuid())
  organizationId String
  venueId        String
  name           String
  slug           String      @unique
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  status         EventStatus @default(DRAFT)
  currency       String      @default("USD")
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  venue        Venue        @relation(fields: [venueId], references: [id])
  ticketTypes  TicketType[]
  orders       Order[]
  tickets      Ticket[]
  checkIns     CheckIn[]
}

// General, VIP, Combo 4 Amigos, etc. El precio vive en PriceTier (tandas).
model TicketType {
  id          String  @id @default(cuid())
  eventId     String
  name        String
  description String?
  // Cuántas personas entran por unidad vendida (combo "4 amigos" = 4).
  groupSize   Int     @default(1)
  // Unidades totales a la venta de este tipo (en combos, unidades de combo).
  totalStock  Int
  sortOrder   Int     @default(0)

  event      Event       @relation(fields: [eventId], references: [id])
  priceTiers PriceTier[]
  orderItems OrderItem[]
  tickets    Ticket[]
}

enum OrderStatus {
  PENDING // reserva iniciada, esperando el pago
  PAID // pago confirmado
  EXPIRED // no pagó a tiempo; la reserva se liberó
  CANCELLED // cancelada manualmente
  REFUNDED // reembolsada (gestión manual, ver SPEC.md sección 7)
}

// Una compra: quién compró, qué, a qué precio y en qué estado está.
model Order {
  id         String      @id @default(cuid())
  eventId    String
  status     OrderStatus @default(PENDING)
  buyerName  String
  buyerEmail String
  totalCents Int
  currency   String      @default("USD")
  // Hasta cuándo vale la reserva de stock de una orden PENDING.
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Cuándo se mandó el email con las entradas (null = todavía no).
  emailSentAt DateTime?

  event   Event       @relation(fields: [eventId], references: [id])
  items   OrderItem[]
  tickets Ticket[]

  @@index([eventId, status])
}

// Detalle de la orden: cuántas unidades de cada tipo y a qué precio
// (el precio queda "congelado" acá aunque la tanda cambie después).
model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  ticketTypeId   String
  quantity       Int
  unitPriceCents Int
  tierName       String?

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
}

enum TicketStatus {
  PENDING // la orden todavía no se pagó
  VALID // pagada, lista para usarse en la puerta
  USED // ya ingresó al evento
  REFUNDED // devuelta
  VOID // anulada (por ejemplo, la orden expiró)
}

// Cada entrada individual, nominativa.
model Ticket {
  id               String       @id @default(cuid())
  orderId          String
  eventId          String
  ticketTypeId     String
  attendeeName     String
  attendeeIdNumber String
  status           TicketStatus @default(PENDING)
  // Token al azar (no correlativo) que identifica la entrada en su QR y en
  // el link "ver mi entrada". Separado del id interno para poder rotarlo
  // si hiciera falta sin afectar las relaciones de la base de datos.
  qrToken          String       @unique @default(uuid())
  createdAt        DateTime     @default(now())

  // Quién y cuándo hizo el primer escaneo válido (para el mensaje de
  // "ya fue usada" si alguien intenta escanearla de nuevo).
  usedAt       DateTime?
  usedByUserId String?

  order      Order      @relation(fields: [orderId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  usedByUser User?      @relation("TicketUsedBy", fields: [usedByUserId], references: [id])
  checkIns   CheckIn[]

  @@index([eventId, status])
}

enum CheckInResult {
  GRANTED // entrada válida, se dejó pasar
  ALREADY_USED // la entrada ya se había escaneado antes
  INVALID // QR que no corresponde a ninguna entrada, o de otro evento
}

// Registro de cada intento de escaneo en la puerta (aceptado o rechazado).
// Sirve para el control de acceso en vivo del organizador y para detectar
// entradas duplicadas o compartidas (SPEC.md sección 7).
model CheckIn {
  id       String        @id @default(cuid())
  eventId  String
  ticketId String? // null si el QR no correspondía a ninguna entrada
  userId   String // qué cuenta de staff escaneó
  result   CheckInResult
  scannedAt DateTime     @default(now())

  event  Event   @relation(fields: [eventId], references: [id])
  ticket Ticket? @relation(fields: [ticketId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@index([eventId, scannedAt])
}

// Tanda de precio con vigencia por fechas (early bird, tanda 2, ...).
// La tanda vigente es la que cumple startsAt <= ahora < endsAt.
// startsAt/endsAt en null significan "sin límite" por ese lado.
model PriceTier {
  id           String    @id @default(cuid())
  ticketTypeId String
  name         String
  priceCents   Int // precio en centavos de USD para evitar errores de redondeo
  startsAt     DateTime?
  endsAt       DateTime?

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
}
